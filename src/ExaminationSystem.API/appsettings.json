{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=ExaminationSystemDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "AllowedHosts": "*",
  "JwtOptions": {
    "SecretKey": "REPLACE-WITH-A-256-BIT-SECRET-KEY-AT-LEAST-32-CHARS",
    "Issuer": "ExaminationSystem.API",
    "Audience": "ExaminationSystem.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AttemptAutoSubmit": {
    "PollIntervalSeconds": 15,
    "MaxAttemptsPerTick": 100,
    "MaxSweepRoundsPerPoll": 25,
    "SubmittingTimeoutMinutes": 10,
    "StuckSubmittingAlertThresholdCount": 10,
    "StuckSubmittingAlertSustainedMinutes": 5,
    "AlertThrottleSeconds": 60,
    "MaxAttemptsPerSweep": 0,
    "ExposeStuckDiagnosticsEndpoint": false,
    "StuckDiagnosticsApiKey": null
  }
}
